{
  "name": "@sky-brain/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/main.ts",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --external:express --external:pg --external:drizzle-orm --external:@electric-sql/pglite --external:@vercel/functions --outfile=dist/vercel.mjs",
    "migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.15",
    "@better-auth/mcp": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@electric-sql/pglite": "0.5.14",
    "@modelcontextprotocol/server": "2.4.0",
    "@sky-brain/shared": "workspace:*",
    "@vercel/functions": "3.10.4",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "auth": "1.7.15",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2"
  }
}
